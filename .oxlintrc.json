{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "vue", "import", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error"
  },
  "rules": {
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],
    "max-lines": "off",
    "max-lines-per-function": "off",
    "max-depth": "off",
    "sort-vars": "off"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "globals": {
    "definePage": "readonly"
  },
  "ignorePatterns": ["dist", "public/gameassets"]
}
