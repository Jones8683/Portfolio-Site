---
import { execFileSync } from 'node:child_process';

const repo = 'https://github.com/Jones8683/Portfolio-Site';
const git = (...args: string[]) => execFileSync('git', args, { encoding: 'utf8' }).trim();

const hash = git('rev-parse', '--short', 'HEAD');
const builtAt = new Date(git('log', '-1', '--format=%cI'));
const timeZone = 'Australia/Adelaide';

const date = builtAt.toLocaleDateString('en-AU', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone,
});

const time = builtAt.toLocaleTimeString('en-AU', {
  hour: 'numeric',
  minute: '2-digit',
  timeZone,
});
---

<footer class="main-footer">
  <div class="footer-line"></div>
  <div class="footer-meta">
    <p>&copy; {new Date().getFullYear()} Jones Jankovic</p>
    <span class="footer-divider" aria-hidden="true">
      |
    </span>
    <a
      class="source-link"
      href={`${repo}/commit/${hash}`}
      target="_blank"
      rel="noopener noreferrer"
    >
      Build {hash} •{' '}
      <time datetime={builtAt.toISOString()}>
        {date} {time}
      </time>
    </a>
  </div>
</footer>

<style>
  .main-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    padding-bottom: 20px;
    margin-top: 40px;
    user-select: none;
  }

  .footer-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: #7c8ba1;
    font-family: var(--font-satoshi);
    font-size: 14px;
    letter-spacing: 0.04em;
  }

  .footer-line {
    width: 90%;
    max-width: 1200px;
    height: 1px;
    margin-bottom: 20px;
    background: rgba(255, 255, 255, 0.1);
  }

  .source-link {
    transition: color 0.2s ease;
  }

  .source-link:hover,
  .source-link:focus-visible {
    color: #94a3b8;
  }

  @media (width <= 480px) {
    .footer-meta {
      flex-direction: column;
      gap: 4px;
      text-align: center;
    }

    .footer-divider {
      display: none;
    }
  }
</style>
