---
import { Image } from 'astro:assets';

import ArrowIcon from '../components/ArrowIcon.astro';
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    name: 'BetterSEQTA+',
    description:
      'Redesigning SEQTA with custom themes, live wallpapers, and quality-of-life upgrades.',
    repo: 'BetterSEQTA/BetterSEQTA-Plus',
  },
  {
    name: 'DesQTA',
    description: 'A powerful desktop app for SEQTA Learn, right on your computer.',
    repo: 'BetterSEQTA/DesQTA',
  },
  {
    name: 'Portfolio Site',
    description: 'This very site - my home for projects, experiments, and games.',
    repo: 'Jones8683/Portfolio-Site',
  },
  {
    name: 'Arduino Buzzer Music',
    description: 'A collection of songs created to be played on an Arduino piezo buzzer.',
    repo: 'Jones8683/Arduino-Buzzer-Music',
  },
];
---

<Layout title="Projects" description="Projects I have made and contributed to.">
  <div class="content-wrap projects-page">
    <h1 class="page-title animate">Projects</h1>
    <p class="page-subtitle animate">A collection of projects I have made and contributed to.</p>

    <div class="project-panel animate">
      {projects.map((project, index) => (
        <a
          class="project-row"
          style={`animation-delay: ${0.1 + index * 0.05}s`}
          href={`https://github.com/${project.repo}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="project-row-bar" aria-hidden="true"></span>
          <span class="project-row-inner">
            <Image
              class="project-logo"
              src={`https://avatars.githubusercontent.com/${project.repo.split('/')[0]}?s=92`}
              alt=""
              width={46}
              height={46}
              densities={[1, 2]}
              quality={90}
              loading="eager"
            />
            <span class="project-info">
              <span class="project-name">{project.name}</span>
              <span class="project-desc">{project.description}</span>
            </span>
            <ArrowIcon class="project-row-arrow" />
          </span>
        </a>
      ))}
    </div>
  </div>
</Layout>

<style>
  .projects-page {
    width: min(92%, 840px);
    padding-bottom: 56px;
  }

  .project-panel {
    display: flex;
    flex-direction: column;
    width: 100%;
    margin-top: 16px;
    padding: 4px 32px;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 16px;
    border: 1px solid rgba(148, 163, 184, 0.2);
    box-shadow: 0 24px 50px rgba(4, 6, 16, 0.45);
    animation-delay: 0.1s;
  }

  .project-row {
    position: relative;
    display: flex;
    padding: 22px 4px;
    text-align: left;
    border-bottom: 1px solid rgba(148, 163, 184, 0.14);
    animation: pull-up 0.7s cubic-bezier(0.33, 1, 0.68, 1) both;
    user-select: none;
  }

  .project-row:last-child {
    border-bottom: none;
  }

  .project-row:focus-visible {
    border-radius: 12px;
  }

  .project-row-inner {
    display: flex;
    align-items: center;
    gap: 18px;
    flex: 1;
    min-width: 0;
    transition: transform 0.3s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .project-row:hover .project-row-inner {
    transform: translateX(16px);
  }

  .project-row-bar {
    position: absolute;
    left: -14px;
    top: 14px;
    bottom: 14px;
    width: 3px;
    background: #ffffff;
    border-radius: 2px;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .project-row:hover .project-row-bar {
    opacity: 1;
  }

  .project-logo {
    flex-shrink: 0;
    width: 46px;
    height: 46px;
    object-fit: cover;
    border-radius: 12px;
    transition: transform 0.4s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .project-row:hover .project-logo {
    transform: rotate(-8deg) scale(1.05);
  }

  .project-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .project-name {
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .project-desc {
    color: #94a3b8;
    font-size: 15px;
    line-height: 1.5;
    transition: color 0.3s ease;
  }

  .project-row:hover .project-desc {
    color: #cbd5e1;
  }

  .project-row-arrow {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    margin-right: 24px;
    color: #3a4f6a;
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease,
      color 0.3s ease;
  }

  .project-row:hover .project-row-arrow {
    color: #87cefa;
    opacity: 1;
    transform: translateX(0);
  }

  @keyframes pull-up {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @media (width <= 720px) {
    .projects-page {
      width: min(95%, 840px);
      padding-bottom: 44px;
    }

    .project-panel {
      padding: 4px 18px;
    }

    .project-row {
      padding: 18px 2px;
    }

    .project-row-inner {
      gap: 14px;
    }

    .project-row:hover .project-row-inner {
      transform: translateX(12px);
    }

    .project-row-bar {
      left: -10px;
    }

    .project-logo {
      width: 40px;
      height: 40px;
      border-radius: 10px;
    }
  }

  @media (width <= 480px) {
    .project-row-arrow {
      display: none;
    }
  }
</style>
