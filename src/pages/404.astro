---
import ArrowIcon from '../components/ArrowIcon.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found" description="This page does not exist.">
  <div class="content-wrap animate">
    <h1 class="not-found-title">404</h1>

    <p class="not-found-subtitle">This is not the page you're looking for</p>

    <a class="back-link" href="/">
      <ArrowIcon class="back-link-arrow" />
      <span class="back-link-text">Take Me Home</span>
    </a>
  </div>
</Layout>

<style>
  .not-found-title {
    font-size: 120px;
    line-height: 1;
  }

  .not-found-subtitle {
    margin-top: -4px;
    margin-bottom: 10px;
    color: #94a3b8;
  }

  .back-link {
    margin-top: 20px;
    font-size: 16px;
  }
</style>
