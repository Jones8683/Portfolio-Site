---
import ArrowIcon from '../../components/ArrowIcon.astro';
import GameControls from '../../components/GameControls.astro';
import GameLayout from '../../layouts/GameLayout.astro';
---

<GameLayout title="Hangman">
  <game-hangman class="game-wrapper">
    <div class="left-section">
      <div class="panel-header">
        <span class="pill">Player 1</span>
        <h1 class="game-title">Hangman</h1>

        <div data-start>
          <p class="subtitle">Enter a secret word for Player 2 to guess</p>
          <div class="word-input-row">
            <input
              class="word-input"
              type="text"
              aria-label="Secret word"
              maxlength="30"
              autocomplete="off"
              spellcheck="false"
            />
            <button class="submit-btn" disabled>
              Set Word
              <ArrowIcon class="arrow-icon" />
            </button>
          </div>
        </div>

        <p class="subtitle" data-playing hidden>
          Guess the hidden word
        </p>
      </div>

      <div class="panel-divider" hidden></div>

      <div class="gallows-section" hidden>
        <svg class="gallows-svg" viewBox="0 0 220 230" fill="none" aria-hidden="true">
          <path
            d="M30 220H190M62 220V14H148M62 58L106 14"
            stroke="#4a4a4e"
            stroke-width="9"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
          <line
            x1="148"
            y1="18"
            x2="148"
            y2="40"
            stroke="#9a9a9e"
            stroke-width="3"
            stroke-linecap="round"
          ></line>

          <g class="part" data-head hidden>
            <circle
              cx="148"
              cy="58"
              r="18"
              fill="rgba(255, 255, 255, 0.06)"
              stroke="#ffffff"
              stroke-width="3.5"
            ></circle>
            <circle cx="142" cy="55" r="2.2" fill="#ffffff"></circle>
            <circle cx="154" cy="55" r="2.2" fill="#ffffff"></circle>
            <path d="M142 66h12" stroke="#ffffff" stroke-width="2" stroke-linecap="round"></path>
          </g>
          {[
            'M148 76V136',
            'M148 92L120 118',
            'M148 92L176 118',
            'M148 136L124 178',
            'M148 136L172 178',
          ].map((limb) => (
            <path
              class="part"
              data-limb
              d={limb}
              stroke="#ffffff"
              stroke-width="3.5"
              stroke-linecap="round"
              hidden
            />
          ))}
        </svg>

        <div class="word-display"></div>
        <template data-slot>
          <span class="letter-slot"></span>
        </template>
      </div>

      <div class="overlay-msg" data-over hidden>
        <h2 class="menu-title outcome-title" data-outcome>
          Game Over
        </h2>
        <p class="outcome-word"></p>
        <button class="overlay-btn" data-restart>
          Play Again
        </button>
      </div>
    </div>

    <div class="right-section faded">
      <div class="info-box danger-box">
        <div class="label danger-label">Wrong Guesses</div>
        <div class="pips-row">
          {Array.from({ length: 6 }, () => (
            <span class="pip" />
          ))}
        </div>
        <div class="wrong-count">
          <span data-wrong-count>0</span>
          <span class="out-of">/6</span>
        </div>
      </div>

      <div class="info-box">
        <div class="label">Wrong Letters</div>
        <div class="wrong-letters">
          <span class="no-letters">—</span>
        </div>
        <template data-chip>
          <span class="wrong-chip"></span>
        </template>
      </div>

      <div class="keyboard-grid">
        {[...'ABCDEFGHIJKLMNOPQRSTUVWXYZ'].map((letter) => (
          <button class="key-btn" data-letter={letter} disabled>
            {letter}
          </button>
        ))}
      </div>

      <GameControls controls={[{ action: 'Guess Letter', keys: 'A - Z' }]} />
    </div>
  </game-hangman>
</GameLayout>

<script src="../../scripts/games/hangman.js"></script>

<style>
  .left-section {
    width: 420px;
    overflow: hidden;
    padding: 0;
  }

  .panel-header {
    padding: 12px 20px 18px;
    text-align: left;
  }

  .panel-divider {
    height: 1px;
    margin: 0 20px;
    background: rgba(255, 255, 255, 0.07);
  }

  .pill {
    display: inline-block;
    padding: 4px 10px;
    margin-bottom: 4px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #94a3b8;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
  }

  .game-title {
    margin: 0 0 14px;
    padding-bottom: 4px;
  }

  .subtitle {
    margin: 0 0 14px;
    color: #7c8ba1;
    font-size: 13px;
  }

  .word-input-row {
    display: flex;
    gap: 10px;
    margin-bottom: 8px;
  }

  .word-input {
    flex: 1;
    min-width: 0;
    padding: 11px 14px;
    color: #ffffff;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.125em;
    text-transform: uppercase;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
  }

  .submit-btn {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 11px 18px;
    color: #000000;
    font-size: 13px;
    font-weight: 900;
    line-height: 1;
    white-space: nowrap;
    background: #ffffff;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .submit-btn:disabled {
    opacity: 0.2;
    cursor: not-allowed;
  }

  .submit-btn:not(:disabled):hover {
    opacity: 0.85;
  }

  .arrow-icon {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    transition: transform 0.4s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .submit-btn:not(:disabled):hover .arrow-icon {
    transform: translateX(4px);
  }

  .gallows-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding: 16px 20px 24px;
    transition:
      opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @starting-style {
    .gallows-section {
      opacity: 0;
      transform: translateY(20px);
    }
  }

  .gallows-svg {
    width: 100%;
    max-width: 260px;
    height: auto;
  }

  .part {
    animation: pop-in 0.15s ease-out;
  }

  .word-display {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 10px;
  }

  .letter-slot {
    display: inline-flex;
    align-items: flex-end;
    justify-content: center;
    min-width: 28px;
    height: 42px;
    font-size: 24px;
    font-weight: 900;
    color: #2d3748;
    border-bottom: 2px solid rgba(255, 255, 255, 0.12);
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .letter-slot.revealed {
    color: #ffffff;
    border-bottom-color: rgba(255, 255, 255, 0.35);
  }

  .letter-slot.space {
    min-width: 12px;
    border-bottom: none;
  }

  .outcome-title {
    margin-bottom: 6px;
    color: #ff4757;
  }

  .outcome-title.won {
    color: #2ed573;
  }

  .outcome-word {
    margin: 0 0 24px;
    color: #7c8ba1;
    font-size: 11px;
    letter-spacing: 0.27em;
    text-transform: uppercase;
  }

  .right-section {
    padding-top: 1px;
    transition: opacity 0.3s ease;
  }

  .right-section.faded {
    opacity: 0.2;
    pointer-events: none;
  }

  .info-box {
    gap: 7px;
    padding: 10px 12px;
  }

  .danger-box {
    background: linear-gradient(135deg, rgba(255, 71, 87, 0.07), transparent);
    border-color: rgba(255, 71, 87, 0.18);
  }

  .danger-label {
    color: #ff4757;
  }

  .pips-row {
    display: flex;
    gap: 6px;
  }

  .pip {
    width: 11px;
    height: 11px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition:
      background-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .pip.dead {
    background: #ff4757;
    border-color: transparent;
    box-shadow: 0 0 8px rgba(255, 71, 87, 0.55);
  }

  .wrong-count {
    font-size: 42px;
    font-weight: 900;
    line-height: 1;
  }

  .out-of {
    font-size: 20px;
    color: #475569;
  }

  .wrong-letters {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    align-items: center;
    min-height: 26px;
  }

  .no-letters {
    color: #2d3748;
    font-size: 13px;
  }

  .wrong-chip {
    padding: 3px 8px;
    color: #ff4757;
    font-weight: 900;
    font-size: 11px;
    letter-spacing: 0.09em;
    background: rgba(255, 71, 87, 0.08);
    border: 1px solid rgba(255, 71, 87, 0.22);
    border-radius: 4px;
  }

  .keyboard-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 5px;
  }

  .key-btn {
    aspect-ratio: 1;
    color: #ffffff;
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    cursor: pointer;
    transition: background-color 0.12s ease;
  }

  .key-btn:not(:disabled):hover {
    background: rgba(255, 255, 255, 0.13);
  }

  .key-btn.correct {
    color: #2ed573;
    background: rgba(46, 213, 115, 0.13);
    border-color: rgba(46, 213, 115, 0.3);
  }

  .key-btn.wrong {
    color: #2d3748;
    background: transparent;
    border-color: rgba(255, 255, 255, 0.03);
  }

  .key-btn:disabled {
    cursor: default;
  }

  @keyframes pop-in {
    from {
      opacity: 0;
    }
  }
</style>
