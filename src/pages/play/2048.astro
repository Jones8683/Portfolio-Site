---
import GameControls from '../../components/GameControls.astro';
import GameLayout from '../../layouts/GameLayout.astro';
---

<GameLayout title="2048">
  <game-2048 class="game-wrapper">
    <div class="left-section">
      <iframe
        class="game-iframe"
        src="/gameassets/2048.html"
        title="2048 game"
        scrolling="no"
      ></iframe>
    </div>

    <div class="right-section">
      <h1 class="game-title">2048</h1>

      <div class="info-box score-box">
        <div class="label score-label">Score</div>
        <div class="value score-value" data-score>
          0
        </div>

        <div class="score-divider"></div>

        <div class="label high-score-label">High Score</div>
        <div class="value high-score-value" data-high-score>
          0
        </div>
      </div>

      <GameControls
        controls={[
          { action: 'Move Tiles', keys: ['↑', '↓', '←', '→'] },
          { action: 'Alternative', keys: ['W', 'A', 'S', 'D'] },
          { action: 'Restart', keys: 'R' },
        ]}
      />
    </div>
  </game-2048>
</GameLayout>

<script>
  import { defineElement, readNumber, writeNumber } from '../../scripts/game';

  const HIGH_SCORE_KEY = '2048-best-score';

  defineElement('game-2048', (root) => {
    const iframe = root.querySelector('iframe');
    const scoreText = root.querySelector('[data-score]');
    const highScoreText = root.querySelector('[data-high-score]');
    const focus = () => iframe.focus();

    const onMessage = ({ source, data }: MessageEvent) => {
      if (source !== iframe.contentWindow || data?.type !== '2048-update') return;

      const highScore = Math.max(readNumber(HIGH_SCORE_KEY), data.score);
      writeNumber(HIGH_SCORE_KEY, highScore);
      scoreText.textContent = String(data.score);
      highScoreText.textContent = String(highScore);
    };

    highScoreText.textContent = String(readNumber(HIGH_SCORE_KEY));
    root.querySelector('.left-section').addEventListener('click', focus);
    iframe.addEventListener('load', focus);
    addEventListener('message', onMessage);
    focus();

    return () => removeEventListener('message', onMessage);
  });
</script>

<style>
  .game-iframe {
    width: 530px;
    height: 530px;
    background: #faf8ef;
  }

  .score-box {
    padding: 16px 10px;
  }

  .label {
    margin-bottom: 4px;
  }
</style>
