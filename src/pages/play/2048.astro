---
import GameControls from '../../components/GameControls.astro';
import GameLayout from '../../layouts/GameLayout.astro';
---

<GameLayout title="2048">
  <game-2048 class="game-wrapper">
    <div class="left-section">
      <iframe
        class="game-iframe"
        src="/gameassets/2048.html"
        title="2048 game"
        scrolling="no"
      ></iframe>
    </div>

    <div class="right-section">
      <h1 class="game-title">2048</h1>

      <div class="info-box score-box">
        <div class="label score-label">Score</div>
        <div class="value score-value" data-score>
          0
        </div>

        <div class="score-divider"></div>

        <div class="label high-score-label">High Score</div>
        <div class="value high-score-value" data-high-score>
          0
        </div>
      </div>

      <GameControls
        controls={[
          { action: 'Move Tiles', keys: ['↑', '↓', '←', '→'] },
          { action: 'Alternative', keys: ['W', 'A', 'S', 'D'] },
          { action: 'Restart', keys: 'R' },
        ]}
      />
    </div>
  </game-2048>
</GameLayout>

<script>
  import { readNumber, writeNumber } from '../../scripts/game';

  const HIGH_SCORE_KEY = '2048-best-score';

  class Game2048 extends HTMLElement {
    iframe!: HTMLIFrameElement;
    scoreText!: HTMLElement;
    highScoreText!: HTMLElement;

    connectedCallback() {
      this.iframe = this.querySelector('iframe') as HTMLIFrameElement;
      this.scoreText = this.querySelector('[data-score]') as HTMLElement;
      this.highScoreText = this.querySelector('[data-high-score]') as HTMLElement;
      this.highScoreText.textContent = String(readNumber(HIGH_SCORE_KEY));

      this.querySelector('.left-section')?.addEventListener('click', this.focusGame);
      this.iframe.addEventListener('load', this.focusGame);
      addEventListener('message', this.onMessage);
      this.focusGame();
    }

    disconnectedCallback() {
      removeEventListener('message', this.onMessage);
    }

    focusGame = () => this.iframe.focus();

    onMessage = ({ source, data }: MessageEvent) => {
      if (source !== this.iframe.contentWindow || data?.type !== '2048-update') return;

      const highScore = Math.max(readNumber(HIGH_SCORE_KEY), data.score);
      writeNumber(HIGH_SCORE_KEY, highScore);
      this.scoreText.textContent = String(data.score);
      this.highScoreText.textContent = String(highScore);
    };
  }

  customElements.define('game-2048', Game2048);
</script>

<style>
  .game-iframe {
    width: 530px;
    height: 530px;
    background: #faf8ef;
  }

  .score-box {
    padding: 16px 10px;
  }

  .label {
    margin-bottom: 4px;
  }

  .high-score-label {
    font-size: 11px;
  }

  .high-score-value {
    font-size: 24px;
    color: #ffd700;
    text-shadow: 0 0 10px rgba(255, 215, 0, 0.2);
  }

  .score-divider {
    width: 100%;
    height: 1px;
    margin: 8px 0;
    background: rgba(255, 255, 255, 0.1);
  }
</style>
