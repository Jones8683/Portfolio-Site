---
import Layout from '../../layouts/Layout.astro';

const games = [
  { name: 'Tetris', icon: '🧱', path: '/play/tetris', color: '#ff4757' },
  { name: '2048', icon: '🔢', path: '/play/2048', color: '#00a2ff' },
  { name: 'Pong', icon: '🏓', path: '/play/pong', color: '#ffd700' },
  { name: 'Minesweeper', icon: '💣', path: '/play/minesweeper', color: '#2ed573' },
  { name: 'Stickman Hook', icon: '🪝', path: '/play/stickman-hook', color: '#ffd700' },
  { name: 'Flappy Bird', icon: '🐦', path: '/play/flappy-bird', color: '#2ed573' },
  { name: 'Hangman', icon: '🧍', path: '/play/hangman', color: '#ff4757' },
  { name: 'Connect 4', icon: '🔵', path: '/play/connect-4', color: '#00a2ff' },
];
---

<Layout title="Arcade" description="Play modern and classic games in your browser.">
  <div class="content-wrap arcade-page">
    <h1 class="page-title animate">Arcade</h1>

    <p class="page-subtitle animate">A collection of modern and classic browser games.</p>

    <div class="arcade-grid animate">
      {games.map((game) => (
        <div class="arcade-card">
          <div class="arcade-card-top">
            <span class="arcade-icon">{game.icon}</span>
            <h2 class="arcade-name">{game.name}</h2>
          </div>
          <a class="arcade-card-bottom" style={`--game-color: ${game.color}`} href={game.path}>
            Play Now
          </a>
        </div>
      ))}
    </div>
  </div>
</Layout>

<style>
  .arcade-page {
    width: min(92%, 1080px);
    padding-bottom: 60px;
  }

  .arcade-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 21px;
    width: 100%;
    animation-delay: 0.1s;
  }

  .arcade-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    height: 210px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    transition:
      transform 0.3s ease,
      border-color 0.3s ease;
  }

  .arcade-card:hover {
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-4px);
  }

  .arcade-card-top {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px;
  }

  .arcade-icon {
    font-size: 40px;
  }

  .arcade-name {
    font-size: 26px;
  }

  .arcade-card-bottom {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 50px;
    font-weight: 900;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--game-color);
    background: color-mix(in srgb, var(--game-color) 5%, transparent);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }

  .arcade-card-bottom:hover {
    color: #1a1c24;
    background: var(--game-color);
  }

  .arcade-card-bottom:focus-visible {
    outline-offset: -3px;
  }

  @media (width <= 960px) {
    .arcade-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (width <= 480px) {
    .arcade-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
