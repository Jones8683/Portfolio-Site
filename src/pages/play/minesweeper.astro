---
import GameControls from '../../components/GameControls.astro';
import GameLayout from '../../layouts/GameLayout.astro';
---

<GameLayout title="Minesweeper">
  <minesweeper-game class="game-wrapper">
    <div class="left-section">
      <div class="grid-frame">
        <div class="grid"></div>
        <template data-cell>
          <div class="cell"></div>
        </template>
      </div>

      <div class="overlay-msg" data-start>
        <h2 class="menu-title">Minesweeper</h2>
        <div class="overlay-actions">
          <button class="overlay-btn" type="button" data-level="easy">
            Easy
          </button>
          <button class="overlay-btn" type="button" data-level="medium">
            Medium
          </button>
          <button class="overlay-btn" type="button" data-level="hard">
            Hard
          </button>
        </div>
      </div>

      <div class="overlay-msg" data-over hidden>
        <h2 class="menu-title outcome-title" data-outcome>
          Game Over
        </h2>
        <button class="overlay-btn" type="button" data-restart>
          Play Again
        </button>
      </div>

      <div class="overlay-msg" data-paused hidden>
        <h2 class="menu-title">Paused</h2>
      </div>
    </div>

    <div class="right-section">
      <h1 class="game-title">Minesweeper</h1>

      <div class="info-box score-box">
        <div class="label mines-label">Mines Left</div>
        <div class="value mines-value" data-mines>
          40
        </div>

        <div class="score-divider"></div>

        <div class="label time-label">Time</div>
        <div class="value time-value" data-time>
          0:00
        </div>
      </div>

      <GameControls
        controls={[
          { action: 'Reveal', keys: 'Click' },
          { action: 'Flag', keys: 'Right Click' },
          { action: 'Pause', keys: ['Esc', 'P'] },
          { action: 'Restart', keys: 'R' },
        ]}
      />
    </div>
  </minesweeper-game>
</GameLayout>

<script>
  import { createMinesweeper } from '../../scripts/games/minesweeper';

  class MinesweeperGame extends HTMLElement {
    destroy = () => {};

    connectedCallback() {
      this.destroy = createMinesweeper(this);
    }

    disconnectedCallback() {
      this.destroy();
    }
  }

  customElements.define('minesweeper-game', MinesweeperGame);
</script>

<style>
  .left-section {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 300px;
    min-height: 300px;
  }

  .game-title {
    font-size: 48px;
  }

  .overlay-actions {
    display: flex;
    gap: 10px;
  }

  .outcome-title {
    color: #ff4757;
  }

  .outcome-title.won {
    color: #2ed573;
  }

  .grid-frame {
    padding: 10px;
    background: #444444;
    border-radius: 4px;
    border: 1px solid #333333;
  }

  .grid {
    display: grid;
    gap: 0;
    background: #666666;
    border: 2px solid #666666;
  }

  .cell {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    font-weight: 900;
    font-size: 16px;
    background: #333333;
    border-top: 2px solid rgba(255, 255, 255, 0.2);
    border-left: 2px solid rgba(255, 255, 255, 0.2);
    border-bottom: 2px solid rgba(0, 0, 0, 0.5);
    border-right: 2px solid rgba(0, 0, 0, 0.5);
    cursor: pointer;
  }

  .cell.revealed {
    background: #222222;
    border: 1px solid #333333;
  }

  .cell.mine {
    background: #cc0000;
    border: 1px solid #990000;
  }

  .mines-label {
    margin-bottom: 4px;
    color: #ffd700;
  }

  .mines-value {
    color: #ffd700;
    font-size: 38px;
  }

  .score-divider {
    width: 100%;
    height: 1px;
    margin: 12px 0;
    background: rgba(255, 255, 255, 0.1);
  }

  .time-label {
    margin-bottom: 4px;
    color: #94a3b8;
  }

  .time-value {
    color: #94a3b8;
    font-size: 24px;
  }
</style>
