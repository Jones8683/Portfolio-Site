---
import GameControls from '../../components/GameControls.astro';
import GameLayout from '../../layouts/GameLayout.astro';
---

<GameLayout title="Flappy Bird">
  <flappy-bird class="game-wrapper">
    <div class="left-section">
      <canvas></canvas>
      <div class="overlay-msg" data-paused hidden>
        <h2 class="menu-title">Paused</h2>
      </div>
    </div>
    <div class="right-section">
      <h1 class="game-title">
        Flappy
        <br />
        Bird
      </h1>
      <div class="info-box score-box">
        <div class="label score-label">Score</div>
        <div class="value score-value" data-score>
          0
        </div>
        <div class="score-divider"></div>
        <div class="label high-score-label">High Score</div>
        <div class="value high-score-value" data-high-score>
          0
        </div>
      </div>
      <GameControls
        controls={[
          { action: 'Jump', keys: 'Click' },
          { action: 'Alternative', keys: ['Space', '↑', 'W'] },
          { action: 'Pause', keys: ['Esc', 'P'] },
        ]}
      />
    </div>
  </flappy-bird>
</GameLayout>

<script>
  import { createFlappyBird } from '../../scripts/games/flappy-bird';

  class FlappyBird extends HTMLElement {
    destroy = () => {};

    connectedCallback() {
      this.destroy = createFlappyBird(this);
    }

    disconnectedCallback() {
      this.destroy();
    }
  }

  customElements.define('flappy-bird', FlappyBird);
</script>

<style>
  .high-score-label {
    margin-bottom: 2px;
    font-size: 11px;
  }

  .high-score-value {
    font-size: 24px;
    color: #ffd700;
    text-shadow: 0 0 10px rgba(255, 215, 0, 0.2);
  }

  .score-divider {
    width: 100%;
    height: 1px;
    margin: 8px 0;
    background: rgba(255, 255, 255, 0.1);
  }

  canvas {
    cursor: pointer;
  }
</style>
