const chipColor = (groupIndex: number, itemIndex: number) =>
  palette[(groupIndex * 3 + itemIndex * 2) % palette.length];
const isExternal = (href: string) => href.startsWith('http');
---

<Layout>
  <div class="home">
    <div class="above-fold">
      <div class="hero-block animate">
        <div class="avatar-wrap">
          <div class="avatar-ring ring-1"></div>
          <div class="avatar-ring ring-2"></div>
          <Image
            class="avatar-img"
            src={profilePic}
            alt="Jones Jankovic"
            width={140}
            height={140}
            densities={[1, 2]}
            quality={90}
            loading="eager"
            fetchpriority="high"
          />
          <div class="avatar-glow"></div>
        </div>

        <h1 class="name-title">Jones Jankovic</h1>

        <NowPlayingPill />
      </div>

      <div class="snake-wrap animate">
        <img
          class="snake-image"
          src="https://raw.githubusercontent.com/jones8683/jones8683/output/github-contribution-grid-snake-dark.svg"
          alt="GitHub contribution snake"
          width="880"
          height="192"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>

    <scroll-cue class="scroll-cue" aria-hidden="true">
      <div class="scroll-cue-nudge">
        <svg class="scroll-cue-icon" viewBox="0 0 24 24" width="22" height="22" fill="none">
          <path
            d="M6 9l6 6 6-6"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </div>
    </scroll-cue>

    <div class="content-wrap home-content animate">
      <section class="about-section">
        <h2 class="about-title">About</h2>
        <div class="about-body">
          <p>
            Hi! I'm Jones, a student from Australia who loves learning new things and exploring in
            general. I'm somewhere between an introvert and an extrovert, and I'm always happy to
            chat.
          </p>
        </div>
      </section>

      <section class="about-section">
        <h2 class="about-title">Interests</h2>
        <div class="about-body">
          {interests.map((group, groupIndex) => (
            <div class="interest-row">
              <span class="interest-label">{group.label}</span>
              <ul class="interest-chips">
                {group.items.map((item, itemIndex) => (
                  <li
                    class="interest-chip"
                    style={`--chip-accent: ${chipColor(groupIndex, itemIndex)}`}
                  >
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section class="about-section">
        <h2 class="about-title">Socials</h2>
        <div class="about-body">
          <p>Find me on…</p>
          <div class="social-list">
            {socials.map((social) => (
              <a
                class="social-row"
                href={social.href}
                target={isExternal(social.href) ? '_blank' : undefined}
                rel={isExternal(social.href) ? 'noopener noreferrer' : undefined}
              >
                <svg
                  class:list={['social-row-icon', { outline: social.outline }]}
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d={social.icon} />
                </svg>
                <span class="social-row-label">{social.label}</span>
                <span class="social-row-value">{social.value}</span>
                <svg class="social-row-arrow" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path
                    d="M4 10h11m0 0-4-4m4 4-4 4"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            ))}
          </div>
          <p class="social-outro">Feel free to reach out if you want to chat!</p>
        </div>
      </section>
    </div>
  </div>
</Layout>

<script>
  let isDismissed = false;

  class ScrollCue extends HTMLElement {
    wasAtTop = false;

    update = () => {
      if (scrollY < 20) this.wasAtTop = true;
      else if (this.wasAtTop && scrollY > 120) isDismissed = true;
      this.style.opacity = String(isDismissed ? 0 : Math.max(0, 1 - scrollY / 120));
    };

    connectedCallback() {
      addEventListener('scroll', this.update, { passive: true });
      this.update();
    }

    disconnectedCallback() {
      removeEventListener('scroll', this.update);
    }
  }

  customElements.define('scroll-cue', ScrollCue);
</script>

<style>
  :global(main:has(.home)) {
    padding-top: 74px;
  }

  .home {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .above-fold {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    width: 100%;
    min-height: calc(100svh - 74px);
    padding: 4px 40px 0;
  }

  .hero-block {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    animation-delay: 0.05s;
  }

  .avatar-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 190px;
    height: 190px;
  }

  .avatar-img {
    position: relative;
    z-index: 2;
    width: 140px;
    height: 140px;
    object-fit: cover;
    border-radius: 50%;
    border: 3px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 0 40px rgba(58, 123, 213, 0.3);
  }

  .avatar-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid transparent;
    animation: spin-ring linear infinite;
  }

  .ring-1 {
    width: 165px;
    height: 165px;
    border-color: rgba(90, 158, 255, 0.35) rgba(90, 158, 255, 0.05) rgba(90, 158, 255, 0.05)
      rgba(90, 158, 255, 0.35);
    animation-duration: 8s;
  }

  .ring-2 {
    width: 185px;
    height: 185px;
    border-color: rgba(21, 224, 214, 0.15) rgba(21, 224, 214, 0.04);
    animation-duration: 14s;
    animation-direction: reverse;
  }

  .avatar-glow {
    position: absolute;
    z-index: 1;
    width: 140px;
    height: 140px;
    background: radial-gradient(circle, rgba(58, 123, 213, 0.25) 0%, transparent 70%);
    border-radius: 50%;
    animation: glow-pulse 3s ease-in-out infinite;
  }

  .name-title {
    margin-bottom: 6px;
    font-size: clamp(36px, 6vw, 56px);
    line-height: 1;
    text-align: center;
    -webkit-text-fill-color: transparent;
    background: linear-gradient(130deg, #80b5ff 0%, #6eeded 100%);
    -webkit-background-clip: text;
    background-clip: text;
  }

  .snake-wrap {
    display: flex;
    justify-content: center;
    width: min(100%, 900px);
    margin: -18px 0 8px;
    animation-delay: 0.1s;
  }

  .snake-image {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 16px 30px rgba(3, 6, 16, 0.5));
    opacity: 0.95;
  }

  .scroll-cue {
    position: fixed;
    right: 0;
    bottom: 28px;
    left: 0;
    z-index: 100;
    display: flex;
    justify-content: center;
    pointer-events: none;
    transition: opacity 0.2s ease-out;
  }

  .scroll-cue-nudge {
    color: #94a3b8;
    animation: cue-nudge 2.2s ease-in-out 2.2s 4;
  }

  .scroll-cue-icon {
    display: block;
    animation: cue-in 0.8s ease-out 1.4s backwards;
  }

  .home-content {
    gap: 20px;
    margin-top: 24px;
    padding-bottom: 60px;
    animation-delay: 0.15s;
  }

  .about-section {
    display: grid;
    grid-template-columns: minmax(140px, 200px) minmax(0, 1fr);
    gap: 24px;
    width: 100%;
    margin-top: 20px;
    padding: 28px 32px;
    text-align: left;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 16px;
    border: 1px solid rgba(148, 163, 184, 0.2);
    box-shadow: 0 24px 50px rgba(4, 6, 16, 0.45);
  }

  .about-title {
    font-size: clamp(24px, 2vw, 30px);
  }

  .about-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .about-body p {
    font-size: 15px;
    line-height: 1.7;
    color: #cbd5e1;
  }

  .interest-row {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    align-items: baseline;
    gap: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .interest-row:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .interest-label {
    font-size: 15px;
    font-weight: 700;
    color: #94a3b8;
  }

  .interest-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
  }

  .interest-chip {
    padding: 5px 12px;
    font-size: 14px;
    line-height: 1.5;
    color: #cbd5e1;
    background: color-mix(in srgb, var(--chip-accent) 7%, transparent);
    border: 1px solid color-mix(in srgb, var(--chip-accent) 22%, transparent);
    border-radius: 999px;
  }

  .social-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 8px;
  }

  .social-row {
    display: flex;
    align-items: center;
    gap: 14px;
    overflow: hidden;
    min-width: 0;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      transform 0.25s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .social-row:hover {
    background: rgba(255, 255, 255, 0.045);
    border-color: rgba(135, 206, 250, 0.2);
    transform: translateX(4px);
  }

  .social-row-icon {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    color: #5d7394;
    fill: currentColor;
    transition: color 0.25s ease;
  }

  .social-row-icon.outline {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .social-row:hover .social-row-icon {
    color: #87cefa;
  }

  .social-row-label {
    flex: 1;
    font-size: 15px;
    font-weight: 700;
    color: #cbd5e1;
    transition: color 0.25s ease;
  }

  .social-row:hover .social-row-label {
    color: #f1f5f9;
  }

  .social-row-value {
    min-width: 0;
    overflow: hidden;
    font-size: 15px;
    color: #87cefa;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .social-row-arrow {
    position: relative;
    top: 1px;
    flex-shrink: 0;
    width: 0;
    height: 16px;
    margin-left: -14px;
    color: #3a4f6a;
    opacity: 0;
    transform: translateX(-6px);
    transition:
      width 0.3s ease,
      margin-left 0.3s ease,
      opacity 0.3s ease,
      transform 0.3s ease,
      color 0.3s ease;
  }

  .social-row:hover .social-row-arrow {
    width: 16px;
    margin-left: 0;
    color: #87cefa;
    opacity: 1;
    transform: translateX(0);
  }

  .social-outro {
    margin-top: 12px;
  }

